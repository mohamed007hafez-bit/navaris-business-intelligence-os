{
  "name": "navaris-local-desktop",
  "version": "0.3.0",
  "description": "NAVARIS Business Intelligence OS v0.3.0 — Gateway Egypt Edition, offline desktop prototype",
  "main": "main.js",
  "author": "Dr. Mohamed Hafez Khalifa",
  "license": "UNLICENSED",
  "scripts": {
    "prepare:web": "node scripts/copy-web.js",
    "start": "npm run prepare:web && electron .",
    "dist:win": "npm run prepare:web && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.navaris.bi.desktop",
    "productName": "NAVARIS Business Intelligence OS v0.3.0",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "web/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}